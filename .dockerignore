# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git & CI
.git
.gitignore
.github

# Secret — tuyệt đối không vào image
.env
.env.*
!.env.example
*.pem
*.key

# Python cache & môi trường ảo
__pycache__
*.py[cod]
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Không cần lúc chạy
tests
screenshots
*.md
grade.py
nginx
docker-compose.yml
railway.toml
render.yaml

# Rác của editor / hệ điều hành
.vscode
.idea
.DS_Store
